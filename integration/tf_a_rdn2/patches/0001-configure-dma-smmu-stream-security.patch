 #include <common/debug.h>
+#include <lib/mmio.h>
 #include <plat/arm/common/plat_arm.h>
 #include <platform_def.h>
 
+#define RDN2_DMA_SMMU_BASE		UL(0x0E000000)
+#define RDN2_DMA_SMMU_SSD_OFFSET	UL(0x4000)
+#define RDN2_DMA_SMMU_NS_STREAMS	U(0x1FF)
+
 #define RDN2_TZC_CPER_REGION				\
 	{NRD_CSS_SP_CPER_BUF_BASE, (NRD_CSS_SP_CPER_BUF_BASE +	\
 	NRD_CSS_SP_CPER_BUF_SIZE) - 1, TZC_REGION_S_NONE,	\
@@ -46,6 +51,18 @@ static const arm_tzc_regions_info_t tzc_regions_mc[][NRD_CHIP_COUNT - 1] = {
 };
 #endif /* NRD_PLATFORM_VARIANT && NRD_CHIP_COUNT */
 
+/*
+ * RD-N2 reuses the Juno DMA subsystem. Its SMMU stream-security table resets
+ * with some PL330 streams Secure; assign all implemented DMA streams to the
+ * Non-secure world before handing the platform to non-secure firmware.
+ */
+static void rdn2_init_dma_smmu(void)
+{
+	uint32_t value = mmio_read_32(RDN2_DMA_SMMU_BASE + RDN2_DMA_SMMU_SSD_OFFSET);
+	mmio_write_32(RDN2_DMA_SMMU_BASE + RDN2_DMA_SMMU_SSD_OFFSET,
+			value | RDN2_DMA_SMMU_NS_STREAMS);
+}
+
 /* Initialize the secure environment */
 void plat_arm_security_setup(void)
 {
@@ -57,6 +74,8 @@ void plat_arm_security_setup(void)
 		arm_tzc400_setup(TZC400_BASE(i), tzc_regions);
 	}
 
+	rdn2_init_dma_smmu();
+
 #if (NRD_PLATFORM_VARIANT == 2 && NRD_CHIP_COUNT > 1)
 	unsigned int j;
 
