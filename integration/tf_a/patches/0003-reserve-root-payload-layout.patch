diff --git a/plat/arm/board/fvp/platform.mk b/plat/arm/board/fvp/platform.mk
--- a/plat/arm/board/fvp/platform.mk
+++ b/plat/arm/board/fvp/platform.mk
@@ -116,6 +116,11 @@ $(eval $(call add_define,FVP_GICR_REGION_PROTECTION))
 # Pass FVP_TRUSTED_SRAM_SIZE to the build system.
 $(eval $(call add_define,FVP_TRUSTED_SRAM_SIZE))
 
+ifneq ($(strip ${VMSA_ROOT_LIB}),)
+VMSA_ROOT_PAYLOAD := 1
+$(eval $(call add_define,VMSA_ROOT_PAYLOAD))
+endif
+
 # Sanity check the cluster count and if FVP_CLUSTER_COUNT <= 2,
 # choose the CCI driver , else the CCN driver
 ifeq ($(FVP_CLUSTER_COUNT), 0)
diff --git a/plat/arm/board/fvp/include/plat.ld.S b/plat/arm/board/fvp/include/plat.ld.S
index 2f99999..454d6a3 100644
--- a/plat/arm/board/fvp/include/plat.ld.S
+++ b/plat/arm/board/fvp/include/plat.ld.S
@@ -8,6 +8,13 @@
 
 #include <lib/xlat_tables/xlat_tables_defs.h>
 
+#if defined(VMSA_ROOT_PAYLOAD) && VMSA_ROOT_PAYLOAD
+#define VMSA_ROOT_PAYLOAD_DATA_BASE \
+	(ARM_EL3_TZC_DRAM1_BASE + 0x001c0000)
+#define VMSA_ROOT_PAYLOAD_CODE_BASE \
+	(ARM_EL3_TZC_DRAM1_BASE + 0x00200000)
+#endif
+
 MEMORY {
     EL3_SEC_DRAM (rw): ORIGIN = ARM_EL3_TZC_DRAM1_BASE, LENGTH = ARM_EL3_TZC_DRAM1_SIZE
 }
@@ -32,6 +39,20 @@ SECTIONS
 	. = ALIGN(PAGE_SIZE);
 	__EL3_SEC_DRAM_END__ = .;
 	} >EL3_SEC_DRAM
+#if defined(VMSA_ROOT_PAYLOAD) && VMSA_ROOT_PAYLOAD
+	ASSERT(__EL3_SEC_DRAM_END__ <= VMSA_ROOT_PAYLOAD_DATA_BASE,
+	       "EL3 TZC data overlaps the Root payload data slot.")
+	.vmsa_root_payload_data VMSA_ROOT_PAYLOAD_DATA_BASE (NOLOAD) : {
+		KEEP(*(.vmsa_root_payload_data))
+	} >EL3_SEC_DRAM
+	ASSERT(SIZEOF(.vmsa_root_payload_data) <= 0x00040000,
+	       "Root payload data exceeds its reserved slot.")
+	.vmsa_root_payload_code VMSA_ROOT_PAYLOAD_CODE_BASE (NOLOAD) : {
+		KEEP(*(.vmsa_root_payload_code))
+	} >EL3_SEC_DRAM
+	ASSERT(SIZEOF(.vmsa_root_payload_code) <= 0x00100000,
+	       "Root payload code exceeds its reserved slot.")
+#endif
 }
 
 #if RECLAIM_INIT_CODE
